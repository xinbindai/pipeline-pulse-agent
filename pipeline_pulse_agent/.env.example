# Copy to `.env` (same folder) and fill in values:  cp .env.example .env
# Loaded automatically by the agent (and by `adk run` / `adk web`).

# ── MCP server(s) ─────────────────────────────────────────────────────────────
# One or more MCP endpoints, comma-separated; the agent exposes the union of
# all their tools:  MCP_SERVER_URL=https://server-a/mcp,https://server-b/mcp
MCP_SERVER_URL=https://your-mcp-server/mcp

# ── LLM ───────────────────────────────────────────────────────────────────────
# Option A — KEYLESS Gemini via Vertex AI (recommended for local dev). No API key;
# uses your Application Default Credentials. One-time:
#     gcloud auth application-default login
# LLM_MODEL must be a versioned Vertex id (not a "-latest" alias); `global` has
# the newest models.
#LLM_MODEL=gemini-2.5-flash
#GOOGLE_GENAI_USE_VERTEXAI=TRUE
#GOOGLE_CLOUD_PROJECT=your-gcp-project
#GOOGLE_CLOUD_LOCATION=global
#
# Option B — API key / other providers. Format "<provider>/<model>"; a bare name
# uses native Gemini (Developer API). Set the matching key.
LLM_MODEL=anthropic/claude-opus-4-8
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...          # LLM_MODEL=openai/gpt-4.1
# GOOGLE_API_KEY=...             # LLM_MODEL=gemini-flash-latest

# ── Self-hosted / OpenAI-compatible engine (llama.cpp, vLLM, Ollama, LM Studio) ─
# Uncomment to route at a local OpenAI-compatible server; set LLM_MODEL above to
# the model it serves. No real API key needed.
#   llama.cpp:  llama-server -m model.gguf --port 8080   -> http://localhost:8080/v1
#   Ollama:     ollama serve                             -> http://localhost:11434/v1
#   vLLM:       vllm serve <model>                       -> http://localhost:8000/v1
# LLM_BASE_URL=http://localhost:8080/v1

# ── RAG subagent — remote Chroma (optional) ───────────────────────────────────
# Set CHROMA_HOST to enable a 'rag_agent' subagent that queries a remote Chroma
# server via a stdio chroma-mcp process. host/port/ssl are the connection;
# CHROMA_COLLECTION is the collection it searches.
# CHROMA_HOST=chroma.example.com
# CHROMA_PORT=8000
# CHROMA_SSL=true
# CHROMA_COLLECTION=knowledge_base
# What the collection holds — steers the subagent and the root's delegation:
# CHROMA_KB_DESCRIPTION="architecture diagrams, troubleshooting, and pipeline details"
