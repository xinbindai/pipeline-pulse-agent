# Example .env for driving the agent with a local llama.cpp server.
# Copy to `.env` (same folder) to use it:  cp .env.llamacpp.example .env
#
# Start the server first (from the repo root):
#   ./start-llamacpp.sh
# It serves an OpenAI-compatible API at http://127.0.0.1:8081/v1 and needs
# --jinja (the helper sets it) so the model can do tool/function calling.

# MCP server(s) — comma-separated for multiple.
MCP_SERVER_URL=https://your-mcp-server/mcp

# Point the agent at the local OpenAI-compatible endpoint. No real API key needed.
LLM_BASE_URL=http://127.0.0.1:8081/v1

# Must match the model id llama.cpp reports at GET /v1/models
# (for llama.cpp that's the .gguf filename).
LLM_MODEL=Qwen3-4B-Q4_K_M.gguf
