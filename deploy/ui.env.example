# Config for deploy-ui.sh. Copy to `ui.env` (git-ignored) and edit:
#   cp deploy/ui.env.example deploy/ui.env
# Sourced by bash. Uncommented values take effect; leave a line commented to use
# the script default / gcloud config.

#PROJECT="my-gcp-project"      # default: gcloud config get-value project
#REGION="us-central1"
#REPO="pipeline-pulse"
#SERVICE="pp-ui"
#AGENT_SERVICE="pp-agent"      # the agent Cloud Run service to point the UI at
#AGENT_URL="https://.../"      # override; else auto-discovered from AGENT_SERVICE
