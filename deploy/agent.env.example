# Config for deploy-agent.sh. Copy to `agent.env` (git-ignored) and edit:
#   cp deploy/agent.env.example deploy/agent.env
# Sourced by bash — use KEY="value" lines. Uncommented values take effect;
# leave a line commented to use the script default / gcloud config.

# --- required ---
MCP_SERVER_URL="https://your-mcp-server/mcp"

# --- common (defaults shown) ---
#PROJECT="my-gcp-project"          # default: gcloud config get-value project
#REGION="us-central1"              # Cloud Run service region
#REPO="pipeline-pulse"
#SERVICE="pp-agent"
# vertex mode needs a versioned Vertex id (NOT a "-latest" alias — those are
# Developer-API-only and 404 on Vertex). The newest models are `global`-only.
LLM_MODEL="gemini-2.5-flash"
LLM_AUTH="vertex"                  # vertex = keyless Gemini | apikey = any provider
#VERTEX_LOCATION="global"          # Vertex model location, SEPARATE from REGION (default global)

# --- apikey mode only (LLM_AUTH="apikey") ---
# For Anthropic / OpenAI / self-hosted (llama.cpp) via an API key in Secret Manager.
# Create the secret once, e.g.:
#   echo -n "sk-ant-..." | gcloud secrets create anthropic-key --data-file=-
#LLM_MODEL="anthropic/claude-opus-4-8"
#API_KEY_ENV="ANTHROPIC_API_KEY"          # ANTHROPIC_API_KEY | OPENAI_API_KEY | GOOGLE_API_KEY
#API_KEY_SECRET="anthropic-key"           # Secret Manager secret name
#LLM_BASE_URL="https://my-llama-host/v1"  # self-hosted OpenAI-compatible endpoint

# --- RAG subagent — remote Chroma (optional) ---
# Set CHROMA_HOST to add a 'rag_agent' that queries a remote Chroma server
# (stdio chroma-mcp). These are deployed as plain env vars on the service.
#CHROMA_HOST="chroma.example.com"
#CHROMA_PORT="8000"
#CHROMA_SSL="true"
#CHROMA_COLLECTION="knowledge_base"
# What the collection holds — steers the subagent and the root's delegation:
#CHROMA_KB_DESCRIPTION="architecture diagrams, troubleshooting, and pipeline details"
